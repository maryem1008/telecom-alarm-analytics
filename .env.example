# Copy this file to `.env` and fill in your Postgres connection details.
# run_local.py, the generator, the Spark job, the dashboard, and the report
# all read from here (via common/db.py) — one place to configure, no Docker
# involved.
#
# Option A — free hosted Postgres (no local install at all):
#   Create a free project at https://neon.tech or https://supabase.com,
#   copy the connection details they give you into the fields below.
#   Hosted providers usually require SSL — set POSTGRES_SSLMODE=require.
#
# Option B — Postgres installed natively on your machine (not Docker):
#   https://www.postgresql.org/download/  (plain installer, Windows/macOS/Linux)
#   Defaults below match a fresh local install with a "telecom" DB/user.

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=telecom
POSTGRES_USER=telecom
POSTGRES_PASSWORD=telecom
POSTGRES_SSLMODE=prefer
